<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>StreakCelebration</RootNamespace>
    <AssemblyName>StreakCelebration.Core</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <PackageId>StreakCelebration.Core</PackageId>
    <Description>UI-independent part of the streak celebration overlay: data and option models, the celebration queue service and the animation timeline. No dependency on MAUI or on any streak library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreakCelebration.Tests" />
    <InternalsVisibleTo Include="StreakCelebration.Maui" />
  </ItemGroup>

</Project>
