<Project Sdk="Microsoft.NET.Sdk.Razor">
<PropertyGroup><TargetFramework>net9.0-android</TargetFramework><OutputType>Exe</OutputType><RootNamespace>DartForge.App</RootNamespace><UseMaui>true</UseMaui><SingleProject>true</SingleProject><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationTitle>DartTA</ApplicationTitle><ApplicationId>com.dartforge.app</ApplicationId><ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion><SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion><EmbedAssembliesIntoApk Condition="'$(RuntimeIdentifier)' != ''">true</EmbedAssembliesIntoApk><AndroidZipAlignment>16</AndroidZipAlignment><MSBuildWarningsAsErrors>$(MSBuildWarningsAsErrors);XA0141</MSBuildWarningsAsErrors></PropertyGroup>
<!-- Play Store release: build-release.ps1 passes the keystore via -p:DartTAKeyStore/-p:DartTAKeyAlias and the
     passwords via the DARTTA_KEY_PASS environment variable, so no secret is stored in this file. -->
<PropertyGroup Condition="'$(Configuration)' == 'Release'">
  <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
  <AndroidUseAapt2>true</AndroidUseAapt2>
  <DebugSymbols>false</DebugSymbols>
  <DebugType>none</DebugType>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(DartTAKeyStore)' != ''">
  <AndroidKeyStore>true</AndroidKeyStore>
  <AndroidSigningKeyStore>$(DartTAKeyStore)</AndroidSigningKeyStore>
  <AndroidSigningKeyAlias>$(DartTAKeyAlias)</AndroidSigningKeyAlias>
  <AndroidSigningStorePass>env:DARTTA_KEY_PASS</AndroidSigningStorePass>
  <AndroidSigningKeyPass>env:DARTTA_KEY_PASS</AndroidSigningKeyPass>
</PropertyGroup>
<ItemGroup><PackageReference Include="Microsoft.Maui.Controls" Version="9.0.111" /><PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.111" /><PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.11" /><PackageReference Include="sqlite-net-pcl" Version="1.11.285" /><PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.10.1.1" /><PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.1" /><PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.6.1" /><PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.8.7.3" /><PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.8.7.3" /><PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.2.1.16" /><PackageReference Include="Xamarin.GooglePlayServices.Ads.Lite" Version="123.6.0.1" /><PackageReference Include="Xamarin.Google.UserMessagingPlatform" Version="3.1.0.2" /></ItemGroup>
<ItemGroup><ProjectReference Include="..\DartForge.Core\DartForge.Core.csproj" /><ProjectReference Include="..\DartForge.Localization\DartForge.Localization.csproj" /><ProjectReference Include="..\SportTA.Streaks\src\SportTA.Streaks\SportTA.Streaks.csproj" /><ProjectReference Include="..\StreakCelebration\src\StreakCelebration.Maui\StreakCelebration.Maui.csproj" /><ProjectReference Include="..\Sta.DataSync\src\Sta.DataSync.Maui\Sta.DataSync.Maui.csproj" /></ItemGroup>
<ItemGroup><MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#FFFFFF" ForegroundScale="0.72" /><MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="220,220" /></ItemGroup>
<ItemGroup><MauiAsset Include="wwwroot\**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
</Project>
