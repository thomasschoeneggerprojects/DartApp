@inject GameSession Session
@inject LocalStore Store
@inject DartBot Bot
<div class="app-shell">
<header><div class="logo">◈ <span>DART</span>FORGE</div><span class="pill">OFFLINE · FREE</span></header>
<main>
@if (tab == "Play")
{
  @if (Session.Current is null || showSetup)
  {
    <section class="hero"><div class="eyebrow">YOUR ARENA. YOUR RULES.</div><h1>Ready to throw?</h1><p>Play local darts with accurate scoring and no interruptions.</p></section>
    <article class="panel"><h2>New match</h2>
    <label>Game mode</label>
    <div class="mode-grid">
      @foreach (var kind in Enum.GetValues<GameKind>())
      {
        var k = kind;
        <button class="mode-btn @(selectedKind == k ? "picked" : "")" @onclick="() => selectedKind = k"><span>@ModeIcon(k)</span>@GameRules.Name(k)</button>
      }
    </div>
    <p class="rules-box">@GameRules.Rules(selectedKind)</p>
    @switch (selectedKind)
    {
      case GameKind.X01:
        <label>Start score</label><select @bind="startScore"><option>101</option><option>301</option><option>501</option><option>701</option><option>1001</option></select>
        <label>Start rule</label><select @bind="inRule"><option value="Straight">Straight in</option><option value="Double">Double in</option><option value="Master">Master in</option></select>
        <label>Finish rule</label><select @bind="outRule"><option value="Double">Double out</option><option value="Straight">Straight out</option><option value="Master">Master out</option></select>
        break;
      case GameKind.Shanghai:
        <label>Rounds</label><select @bind="shanghaiRounds"><option value="7">7 rounds (1–7)</option><option value="20">20 rounds (1–20)</option></select>
        break;
      case GameKind.CountUp:
        <label>Target score</label><select @bind="countUpTarget"><option>300</option><option>500</option><option>1000</option></select>
        break;
      case GameKind.HighScore:
        <label>Rounds</label><select @bind="highScoreRounds"><option>3</option><option>5</option><option>7</option><option>10</option></select>
        break;
      case GameKind.AroundTheClock:
        <label>Round limit</label><select @bind="atcRounds"><option>10</option><option>20</option><option>30</option></select>
        break;
    }
    <label>Your name</label><input @bind="playerName" maxlength="25" />
    <label>Opponent</label>
    <div class="multiplier">
      <button class="@(opponent == Opponent.DartBot ? "picked" : "")" @onclick="() => opponent = Opponent.DartBot">DARTBOT</button>
      <button class="@(opponent == Opponent.SecondPlayer ? "picked" : "")" @onclick="() => opponent = Opponent.SecondPlayer">2ND PLAYER</button>
      <button class="@(opponent == Opponent.Solo ? "picked" : "")" @onclick="() => opponent = Opponent.Solo">SOLO</button>
    </div>
    @if (opponent == Opponent.DartBot) { <label>DartBot level: @botLevel</label><input type="range" min="1" max="20" @bind="botLevel" /> }
    @if (opponent == Opponent.SecondPlayer) { <label>Second player</label><input @bind="secondName" maxlength="25" /> }
    <button class="primary full" @onclick="Start">START @GameRules.Name(selectedKind).ToUpperInvariant() →</button></article>
    <div class="footer-ad">AD SPACE · BANNER DISABLED (OFFLINE)</div>
  }
  else
  {
    <MatchView Game="Session.Current" Snap="Session.Current.Snapshot" BotRunning="botRunning" Message="@message"
               OnThrow="Throw" OnBot="BotTurn" OnUndo="Undo" OnRedo="Redo" OnNew="() => showSetup = true" OnRematch="Rematch" />
  }
}
else if (tab == "Training")
{
  <div class="eyebrow">BUILD CONSISTENCY</div><h1>Training Lab</h1><p class="muted">Every dart counts. Sessions are saved locally.</p>
  <article class="panel"><h2>New training</h2><label>Exercise</label><select @bind="exercise"><option value="T20">Triple 20</option><option value="D20">Double 20</option><option value="D16">Double 16</option><option value="Bull">Bull Training</option><option value="Random">Random Targets</option></select><label>Number of darts</label><select @bind="trainingDarts"><option>9</option><option>21</option><option>30</option><option>60</option><option>100</option></select>
    @if (!trainingActive) { <button class="primary full" @onclick="BeginTraining">START TRAINING</button> }
    else { <div class="metric">@trainingThrown / @trainingDarts darts · @trainingHits hits</div><p>Target: <strong>@currentTarget</strong></p><div class="quick-row"><button class="primary" @onclick="()=>TrainingThrow(true)">HIT</button><button @onclick="()=>TrainingThrow(false)">MISS</button></div><button class="subtle full" @onclick="EndTraining">FINISH SESSION</button> }
  </article>
  @if (trainingHistory.Count > 0) { <article class="panel"><h2>Training history</h2>@foreach(var t in trainingHistory.Take(10)) { <div class="history-row"><span>@t.Mode</span><strong>@t.Score / @t.Darts hits</strong></div> }</article> }
}
else if(tab == "Challenges")
{
  <div class="eyebrow">KEEP GETTING BETTER</div><h1>Challenges</h1><article class="panel"><h2>Daily goals</h2><p>Offline goals refresh every local calendar day. Practice toward your goals.</p>@foreach(var c in new[]{("Practice 21 darts",21),("Practice 60 darts",60),("Hit 10 targets",10)}) { var progress=c.Item1.Contains("Hit")?trainingHistory.Where(x=>x.PlayedUtc.StartsWith(DateTimeOffset.Now.ToString("yyyy-MM-dd"))).Sum(x=>x.Score):trainingHistory.Where(x=>x.PlayedUtc.StartsWith(DateTimeOffset.Now.ToString("yyyy-MM-dd"))).Sum(x=>x.Darts); <div class="challenge"><span>@c.Item1</span><b>@Math.Min(progress,c.Item2) / @c.Item2</b><div class="progress"><div style="width:@(100*Math.Min(progress,c.Item2)/c.Item2)%"></div></div></div> }</article>
}
else if (tab == "Statistics")
{
  <div class="eyebrow">YOUR PERFORMANCE</div><h1>Statistics</h1><div class="stat-grid"><div class="panel"><div class="eyebrow">MATCHES</div><div class="metric">@matchHistory.Count</div></div><div class="panel"><div class="eyebrow">TRAINING DARTS</div><div class="metric">@trainingHistory.Sum(x=>x.Darts)</div></div><div class="panel"><div class="eyebrow">TRAINING HITS</div><div class="metric">@trainingHistory.Sum(x=>x.Score)</div></div><div class="panel"><div class="eyebrow">HIT RATE</div><div class="metric">@(trainingHistory.Sum(x=>x.Darts)==0 ? "0%" : (100.0*trainingHistory.Sum(x=>x.Score)/trainingHistory.Sum(x=>x.Darts)).ToString("F1")+"%")</div></div></div><article class="panel"><h2>Recent matches</h2>@if(matchHistory.Count==0) { <p class="muted">No finished matches yet.</p> }@foreach(var r in matchHistory.Take(10)) { <div class="history-row"><span>@Name(r.Mode)</span><strong>@r.Winner</strong></div> }</article><div class="footer-ad">AD SPACE · BANNER DISABLED (OFFLINE)</div>
}
else { <h1>Settings</h1><article class="panel"><h2>Privacy first</h2><p>Game scoring and training are offline. SQLite stores data on this device. No account is required and no advertisement SDK is installed.</p><p>Build: 0.1.0 · .NET 8 MAUI</p></article> }
</main>
<nav>@foreach(var name in new[]{"Play","Training","Challenges","Statistics","Settings"}) { <button class="@(tab==name?"nav-active":"")" @onclick="()=>Navigate(name)"><span>@Icon(name)</span><small>@name</small></button> }</nav>
</div>
@code {
 private string tab="Play", playerName="Player 1", secondName="Player 2", exercise="T20", currentTarget="T20", message="";
 private bool showSetup=true, trainingActive, botRunning;
 private int startScore=501,botLevel=10,trainingDarts=21,trainingThrown,trainingHits,shanghaiRounds=7,countUpTarget=300,highScoreRounds=7,atcRounds=30;
 private OutRule outRule=OutRule.Double;
 private InRule inRule=InRule.Straight;
 private Opponent opponent=Opponent.DartBot;
 private GameKind selectedKind=GameKind.X01;
 private List<MatchRecord> matchHistory=new(); private List<TrainingRecord> trainingHistory=new();
 protected override async Task OnInitializedAsync() => await Refresh();
 private async Task Refresh() { matchHistory=await Store.MatchesAsync(); trainingHistory=await Store.TrainingAsync(); }
 private async Task Navigate(string dest) { tab=dest; if(dest=="Statistics"||dest=="Training"||dest=="Challenges") await Refresh(); }

 private GameSettings BuildSettings() => selectedKind switch
 {
   GameKind.X01 => new GameSettings(GameKind.X01, startScore, 20, outRule, inRule),
   GameKind.Shanghai => new GameSettings(GameKind.Shanghai, MaxRounds: shanghaiRounds),
   GameKind.CountUp => new GameSettings(GameKind.CountUp, countUpTarget, 99),
   GameKind.HighScore => new GameSettings(GameKind.HighScore, MaxRounds: highScoreRounds),
   GameKind.AroundTheClock => new GameSettings(GameKind.AroundTheClock, MaxRounds: atcRounds),
   GameKind.HalveIt => new GameSettings(GameKind.HalveIt, MaxRounds: GameRules.HalveItTargets.Length),
   GameKind.Bob27 => new GameSettings(GameKind.Bob27, MaxRounds: GameRules.Bob27Rounds),
   _ => new GameSettings(selectedKind)
 };

 private void Start() { Session.Start(BuildSettings(), playerName, opponent, secondName, botLevel); showSetup=false; message=""; }
 private void Rematch() { Session.Rematch(); message=""; }

 private async Task Throw(DartHit hit)
 {
   if(Session.Current is null || botRunning) return;
   try { message=Session.Current.Throw(hit).Message; }
   catch(Exception ex){ message=ex.Message; return; }
   await SaveIfFinished();
   var snap=Session.Current.Snapshot;
   if(!snap.IsFinished && snap.Players[snap.ActivePlayer].IsBot) await BotTurn();
 }

 private async Task BotTurn()
 {
  var game=Session.Current;
  if(game is null || botRunning) return;
  botRunning=true;
  try
  {
    while(true)
    {
      var snap=game.Snapshot;
      if(snap.IsFinished || !snap.Players[snap.ActivePlayer].IsBot || Session.Current != game) break;
      await Task.Delay(snap.DartsInVisit == 0 ? 700 : 450);
      if(Session.Current != game) break;
      var name=snap.Players[snap.ActivePlayer].Name;
      var hit=Bot.ThrowFor(game, Session.BotLevel);
      message=$"{name}: {hit.Label} — {game.Throw(hit).Message}";
      StateHasChanged();
    }
  }
  finally { botRunning=false; }
  await SaveIfFinished();
 }

 private static bool BotUp(DartGame g) { var s=g.Snapshot; return !s.IsFinished && s.Players[s.ActivePlayer].IsBot; }
 /// <summary>Undo the last dart; DartBot darts are rolled back together with it so the human is at the oche again.</summary>
 private void Undo()
 {
   var g=Session.Current; if(g is null || botRunning || !g.Undo()) return;
   while(BotUp(g) && g.CanUndo) g.Undo();
   message="Undone";
 }
 private async Task Redo()
 {
   var g=Session.Current; if(g is null || botRunning || !g.Redo()) return;
   while(BotUp(g) && g.CanRedo) g.Redo();
   message="Redone";
   await SaveIfFinished();
 }
 private async Task SaveIfFinished() { if(Session.Current is not null && Session.Current.Snapshot.IsFinished && !Session.Saved) { await Store.SaveMatchAsync(Session.Current.Snapshot);Session.MarkSaved();await Refresh(); } }
 private void BeginTraining(){trainingActive=true;trainingThrown=trainingHits=0;currentTarget=exercise;}
 private async Task TrainingThrow(bool hit){if(!trainingActive)return;trainingThrown++;if(hit)trainingHits++;if(exercise=="Random")currentTarget=$"T{Random.Shared.Next(1,21)}";if(trainingThrown>=trainingDarts)await EndTraining();}
 private async Task EndTraining(){if(!trainingActive)return;trainingActive=false;await Store.SaveTrainingAsync(exercise,trainingHits,trainingThrown);await Refresh();}
 private static string Name(string mode)=>Enum.TryParse<GameKind>(mode, out var k) ? GameRules.Name(k) : mode;
 private static string ModeIcon(GameKind k)=>k switch { GameKind.X01=>"501", GameKind.Cricket=>"✕", GameKind.CutThroatCricket=>"✂", GameKind.NoScoreCricket=>"⚑", GameKind.AroundTheClock=>"◷", GameKind.Shanghai=>"上", GameKind.CountUp=>"↑", GameKind.HighScore=>"★", GameKind.HalveIt=>"½", GameKind.Bob27=>"27", _=>"◎" };
 private static string Icon(string name)=>name switch {"Play"=>"◎","Training"=>"◈","Challenges"=>"★","Statistics"=>"▥",_=>"⚙"};
}
