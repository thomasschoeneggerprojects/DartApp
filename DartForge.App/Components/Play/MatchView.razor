@using DartForge.App.Components.Games
@* Live match screen: a slim top bar + the board that fits the selected game. *@
<div class="match-bar">
  <button class="icon-btn" @onclick="OnNew" title="Back to setup"><Icon Name="back" /></button>
  <div class="mb-title"><Icon Name="@Icon.ForGame(Snap.Settings.Kind)" Size="18" /> @GameRules.Name(Snap.Settings.Kind)</div>
  <span class="pill">@RoundLabel</span>
  <button class="icon-btn @(showRules ? "on" : "")" @onclick="() => showRules = !showRules" title="Rules"><Icon Name="help" /></button>
</div>
@if (showRules) { <p class="rules-box">@GameRules.Rules(Snap.Settings.Kind)</p> }
@if (Snap.Players.Count > 2 && !Snap.IsFinished)
{
  <div class="turn-order">
    @for (int i = 0; i < Snap.Players.Count; i++)
    {
      var p = Snap.Players[i];
      <span class="turn-chip @(i == Snap.ActivePlayer ? "active" : "") @(p.Eliminated ? "out" : "")"><Icon Name="@(p.IsBot ? "bot" : "user")" Size="12" /> @p.Name</span>
    }
  </div>
}
@if (Snap.IsFinished)
{
  <div class="success"><Icon Name="trophy" Size="22" /> @(Snap.Players.FirstOrDefault(x => x.Id == Snap.WinnerId)?.Name ?? "Game over") @(Snap.WinnerId is null ? "" : "wins!")</div>
}

@switch (Snap.Settings.Kind)
{
  case GameKind.X01:
    <X01Board Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
  case GameKind.Cricket:
  case GameKind.CutThroatCricket:
  case GameKind.NoScoreCricket:
    <CricketBoard Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
  case GameKind.AroundTheClock:
    <AroundTheClockBoard Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
  case GameKind.Shanghai:
    <ShanghaiBoard Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
  case GameKind.HalveIt:
    <HalveItBoard Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
  case GameKind.Bob27:
    <Bob27Board Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
  default:
    <PointsBoard Game="Game" Snap="Snap" CanInput="HumanCanThrow" OnThrow="OnThrow" />
    break;
}

@if (!Snap.IsFinished)
{
  @if (Snap.Players[Snap.ActivePlayer].IsBot)
  {
    <article class="panel throw-panel bot-panel">
      <VisitDarts Darts="Game.Pending" Name="@Snap.Players[Snap.ActivePlayer].Name" IsBot="true" Hint="@(BotRunning ? "throwing…" : null)" />
      @if (!BotRunning) { <button class="primary full" @onclick="OnBot"><Icon Name="play" Size="16" /> LET DARTBOT THROW</button> }
    </article>
  }
  <div class="control-row">
    <button class="icon-btn wide" disabled="@(!Game.CanUndo || BotRunning)" @onclick="OnUndo"><Icon Name="undo" /> Undo</button>
    <button class="icon-btn wide" disabled="@(!Game.CanRedo || BotRunning)" @onclick="OnRedo"><Icon Name="redo" /> Redo</button>
  </div>
  @if (!string.IsNullOrEmpty(Message)) { <p class="notice">@Message</p> }
}
else
{
  <article class="panel">
    @foreach (var p in Standings)
    {
      <div class="history-row"><span><Icon Name="@(p.Id == Snap.WinnerId ? "trophy" : p.IsBot ? "bot" : "user")" Size="16" /> @p.Name</span><strong>@ResultText(p)</strong></div>
    }
    <div class="control-row">
      <button class="icon-btn wide" disabled="@(!Game.CanUndo)" @onclick="OnUndo"><Icon Name="undo" /> Undo</button>
      <button class="primary wide" @onclick="OnRematch"><Icon Name="refresh" Size="18" /> Rematch</button>
    </div>
    <button class="subtle full" @onclick="OnNew"><Icon Name="sliders" Size="18" /> New game</button>
  </article>
}
@code {
  [Parameter, EditorRequired] public DartGame Game { get; set; } = default!;
  [Parameter, EditorRequired] public GameSnapshot Snap { get; set; } = default!;
  [Parameter] public bool BotRunning { get; set; }
  [Parameter] public string? Message { get; set; }
  [Parameter] public EventCallback<DartHit> OnThrow { get; set; }
  [Parameter] public EventCallback OnBot { get; set; }
  [Parameter] public EventCallback OnUndo { get; set; }
  [Parameter] public EventCallback OnRedo { get; set; }
  [Parameter] public EventCallback OnNew { get; set; }
  [Parameter] public EventCallback OnRematch { get; set; }
  private bool showRules;

  private bool HumanCanThrow => !Snap.IsFinished && !Snap.Players[Snap.ActivePlayer].IsBot && !BotRunning;

  private string RoundLabel => GameRules.IsRoundLimited(Snap.Settings.Kind)
    ? $"R {Math.Min(Snap.Round, GameRules.TotalRounds(Snap.Settings))}/{GameRules.TotalRounds(Snap.Settings)}"
    : $"R {Snap.Round}";

  private IEnumerable<PlayerSnapshot> Standings => Snap.Settings.Kind switch
  {
    GameKind.X01 or GameKind.CutThroatCricket => Snap.Players.OrderByDescending(p => p.Id == Snap.WinnerId).ThenBy(p => p.Score),
    _ => Snap.Players.OrderByDescending(p => p.Id == Snap.WinnerId).ThenByDescending(p => p.Score)
  };

  private string ResultText(PlayerSnapshot p) => Snap.Settings.Kind switch
  {
    GameKind.X01 => p.Score == 0 ? $"Ø {(p.DartsThrown == 0 ? 0 : p.TotalScored * 3.0 / p.DartsThrown):F1}" : $"{p.Score} left",
    GameKind.NoScoreCricket => $"{GameRules.CricketNumbers.Count(n => p.MarksOn(n) >= 3)}/7",
    GameKind.AroundTheClock => $"{p.Score}/20",
    GameKind.Bob27 when p.Eliminated => $"{p.Score} · out",
    _ => $"{p.Score}"
  };
}
