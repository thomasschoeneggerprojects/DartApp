@* Classic cricket marks: / , X and circled X. *@
<svg class="cricket-mark @(Count >= 3 ? "closed" : "")" viewBox="0 0 40 40" aria-label="@Count marks" role="img">
  @if (Count >= 1) { <line x1="11" y1="29" x2="29" y2="11" /> }
  @if (Count >= 2) { <line x1="11" y1="11" x2="29" y2="29" /> }
  @if (Count >= 3) { <circle cx="20" cy="20" r="16" /> }
</svg>
@code {
  [Parameter] public int Count { get; set; }
}
