  {
    GameKind.X01 => "flame", GameKind.Cricket => "cricket", GameKind.CutThroatCricket => "scissors", GameKind.NoScoreCricket => "flag",
    GameKind.AroundTheClock => "clock", GameKind.Shanghai => "layers", GameKind.CountUp => "trend", GameKind.HighScore => "star",
    GameKind.HalveIt => "half", GameKind.Bob27 => "ladder", _ => "target"
  };

