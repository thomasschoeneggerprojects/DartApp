  [Parameter] public string Name { get; set; } = "target";
  [Parameter] public int Size { get; set; } = 20;
  [Parameter] public string Stroke { get; set; } = "2";
  [Parameter] public string? Class { get; set; }
  private MarkupString Inner => new(Paths.GetValueOrDefault(Name) ?? Paths["target"]);

