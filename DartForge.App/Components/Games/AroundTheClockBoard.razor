@inherits GameBoardBase
<div class="atc-list @(Compact ? "compact" : "")">
  @for (int i = 0; i < Snap.Players.Count; i++)
  {
    var p = Snap.Players[i];
    var done = p.Score >= 20;
    var index = i;
    <PlayerCard Player="p" Active="IsActive(i)" Value="@(done ? "✓" : (p.Score + 1).ToString())" ValueClass="accent">
      @if (!Compact || IsActive(index))
      {
        <div class="atc-track">
          @for (int n = 1; n <= 20; n++)
          {
            <span class="atc-cell @(n <= p.Score ? "hit" : n == p.Score + 1 ? "current" : "")">@n</span>
          }
        </div>
      }
      else
      {
        <div class="progress"><div style="width:@(p.Score * 5)%"></div></div>
      }
    </PlayerCard>
  }
</div>
@if (CanInput && Game.CurrentTarget is { } target)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Name="@Active.Name" Hint="@($"→ {target.Label}")" />
    <TargetPad Target="target" OnThrow="OnThrow" />
  </article>
}
