@inherits GameBoardBase
@{
  var target = GameRules.HalveItTarget(Snap.Round);
}
<div class="round-banner">
  <Icon Name="half" Size="30" Class="rb-icon" />
  <div class="rb-target">@Loc.TargetLabel(target)</div>
  <div class="rb-label">@L("Gameplay_HalveItHint")</div>
</div>
<div class="target-path">
  @for (int r = 1; r <= TotalRounds; r++)
  {
    <span class="@(r < Snap.Round ? "done" : r == Snap.Round && !Snap.IsFinished ? "current" : "")">@ShortLabel(GameRules.HalveItTarget(r))</span>
  }
</div>
<div class="@CardsClass">
  @for (int i = 0; i < Snap.Players.Count; i++)
  {
    var p = Snap.Players[i];
    var last = VisitsOf(p.Id).LastOrDefault();
    var halved = last is not null && !last.Darts.Any(GameRules.HalveItTarget(last.Round).Matches);
    <PlayerCard Player="p" Active="IsActive(i)" Value="@p.Score.ToString()">
      @if (last is not null)
      {
        <div class="tag @(halved ? "bad" : "good")"><Icon Name="@(halved ? "half" : "check")" Size="12" /> @(halved ? L("Gameplay_Halved") : Signed(last.Score))</div>
      }
    </PlayerCard>
  }
</div>
@if (CanInput)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Good="target.Matches" Name="@Active.Name" />
    @if (target.Segment is not null)
    {
      <TargetPad Target="target" OnThrow="OnThrow" Multipliers="@(target.Segment == 25 ? BullMults : AllMults)" />
    }
    else
    {
      <DartPad OnThrow="OnThrow" FixedMultiplier="target.Multiplier" />
    }
  </article>
}
@code {
  private static readonly int[] BullMults = [1, 2];
  private static readonly int[] AllMults = [1, 2, 3];
  private static string ShortLabel(TargetInfo t) => t.Segment == 25 ? "B" : t.Segment?.ToString() ?? (t.Multiplier == 2 ? "D" : "T");
}
