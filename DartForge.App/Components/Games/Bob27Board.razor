@inherits GameBoardBase
@{
  var target = GameRules.Bob27Target(Snap.Round);
  var value = GameRules.Bob27Value(Snap.Round);
}
<div class="round-banner">
  <Icon Name="ladder" Size="30" Class="rb-icon" />
  <div class="rb-target">@target.Label</div>
  <div class="rb-label"><span class="good-txt">+@value</span> / <span class="bad-txt">−@value</span></div>
</div>
<div class="atc-list @(Compact ? "compact" : "")">
  @for (int i = 0; i < Snap.Players.Count; i++)
  {
    var p = Snap.Players[i];
    var index = i;
    <PlayerCard Player="p" Active="IsActive(i)" Out="p.Eliminated" Value="@p.Score.ToString()" ValueClass="@(p.Score <= 0 ? "neg" : "")" Sub="@(p.Eliminated ? "OUT" : null)">
      @if (IsActive(index) || Snap.Players.Count <= 2)
      {
        <div class="bob-ladder">
          @for (int r = 1; r <= TotalRounds; r++)
          {
            var v = VisitOf(p.Id, r);
            <span class="@(v is null ? (r == Snap.Round && IsActive(index) ? "current" : "") : v.Score > 0 ? "hit" : "miss")">@(r >= GameRules.Bob27Rounds ? "B" : r.ToString())</span>
          }
        </div>
      }
    </PlayerCard>
  }
</div>
@if (CanInput)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Good="target.Matches" Name="@Active.Name" />
    <TargetPad Target="target" OnThrow="OnThrow" Multipliers="DoubleOnly" MissLabel="Miss" />
  </article>
}
@code {
  private static readonly int[] DoubleOnly = [2];
}
