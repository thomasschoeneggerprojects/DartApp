@inherits GameBoardBase
<div class="@CardsClass">
  @for (int i = 0; i < Snap.Players.Count; i++)
  {
    var p = Snap.Players[i];
    var route = IsActive(i) && p.Opened ? Checkout.Suggest(p.Score, DartsLeft, Snap.Settings.Out) : null;
    <PlayerCard Player="p" Active="IsActive(i)" Value="@p.Score.ToString()" Sub="@($"Ø {Avg(p)}")">
      @if (!p.Opened) { <div class="tag warn"><Icon Name="bolt" Size="12" /> @(Snap.Settings.In == InRule.Double ? "Double in" : "Master in")</div> }
      else if (route is not null) { <div class="checkout"><Icon Name="flag" Size="12" /> @(string.Join(" ", route.Select(d => d.Label)))</div> }
    </PlayerCard>
  }
</div>
@if (CanInput)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Name="@Active.Name" Hint="@($"{Active.Score} left")" />
    <DartPad OnThrow="OnThrow" Highlight="CheckoutTargets" />
  </article>
}
@code {
  private ISet<int>? CheckoutTargets
  {
    get
    {
      if (!Active.Opened) return null;
      var route = Checkout.Suggest(Active.Score, DartsLeft, Snap.Settings.Out);
      return route is null ? null : new HashSet<int>(route.Take(1).Select(d => d.Segment));
    }
  }
}
