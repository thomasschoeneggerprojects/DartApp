@inherits GameBoardBase
@* Count Up (race to a target) and High Score (most points after N rounds). *@
@{
  var countUp = Snap.Settings.Kind == GameKind.CountUp;
  var goal = Snap.Settings.StartScore;
}
<div class="round-banner">
  <Icon Name="@(countUp ? "flag" : "star")" Size="30" Class="rb-icon" />
  <div class="rb-target">@(countUp ? goal.ToString() : $"{Math.Min(Snap.Round, TotalRounds)}/{TotalRounds}")</div>
  <div class="rb-label">@(countUp ? "race to" : "rounds")</div>
</div>
<div class="@CardsClass">
  @for (int i = 0; i < Snap.Players.Count; i++)
  {
    var p = Snap.Players[i];
    <PlayerCard Player="p" Active="IsActive(i)" Value="@p.Score.ToString()">
      @if (countUp) { <div class="progress"><div style="width:@(Math.Min(100, 100 * p.Score / Math.Max(1, goal)))%"></div></div> }
    </PlayerCard>
  }
</div>
@if (CanInput)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Name="@Active.Name" Hint="@($"+{PendingDarts.Sum(d => d.Score)}")" />
    <DartPad OnThrow="OnThrow" />
  </article>
}
