@inherits GameBoardBase
@{
  var target = GameRules.ShanghaiTarget(Snap.Round);
  var hitMults = Snap.IsFinished ? new HashSet<int>() : PendingDarts.Where(target.Matches).Select(d => d.Multiplier).ToHashSet();
}
<div class="round-banner">
  <Icon Name="target" Size="30" Class="rb-icon" />
  <div class="rb-target">@target.Segment</div>
  <div class="shanghai-meter" title="@L("Gameplay_ShanghaiHint")">
    <span class="@(hitMults.Contains(1) ? "on" : "")">S</span><span class="@(hitMults.Contains(2) ? "on" : "")">D</span><span class="@(hitMults.Contains(3) ? "on" : "")">T</span>
  </div>
</div>
<div class="@CardsClass">
  @for (int i = 0; i < Snap.Players.Count; i++)
  {
    var p = Snap.Players[i];
    <PlayerCard Player="p" Active="IsActive(i)" Value="@p.Score.ToString()" />
  }
</div>
@if (CanInput)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Good="target.Matches" Name="@Active.Name" />
    <TargetPad Target="target" OnThrow="OnThrow" />
  </article>
}
