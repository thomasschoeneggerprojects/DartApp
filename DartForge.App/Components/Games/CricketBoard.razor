@inherits GameBoardBase
@{
  var two = Snap.Players.Count == 2;
  var cols = two ? "minmax(0,1fr) 72px minmax(0,1fr)" : $"{(Compact ? 48 : 60)}px repeat({Snap.Players.Count}, minmax(0,1fr))";
}
<div class="cricket-board @(two ? "" : "multi") @(Compact ? "compact" : "")" style="grid-template-columns:@cols">
  @if (two)
  {
    @PlayerHeader(0)
    <div class="cb-corner"><Icon Name="@Icon.ForGame(Snap.Settings.Kind)" Size="18" /></div>
    @PlayerHeader(1)
  }
  else
  {
    <div class="cb-corner"><Icon Name="@Icon.ForGame(Snap.Settings.Kind)" Size="18" /></div>
    for (int i = 0; i < Snap.Players.Count; i++) { @PlayerHeader(i) }
  }
  @foreach (var n in GameRules.CricketNumbers)
  {
    var number = n;
    var dead = Snap.Players.All(p => p.MarksOn(number) >= 3);
    if (two)
    {
      @MarkCell(0, number, dead)
      @NumberCell(number, dead)
      @MarkCell(1, number, dead)
    }
    else
    {
      @NumberCell(number, dead)
      for (int i = 0; i < Snap.Players.Count; i++) { @MarkCell(i, number, dead) }
    }
  }
</div>
@if (CanInput)
{
  <article class="panel throw-panel">
    <VisitDarts Darts="PendingDarts" Good="IsCricketHit" Name="@Active.Name" Hint="@L("Gameplay_TapNumber")" />
    <div class="multiplier">
      <button class="@(multiplier==1?"picked":"")" @onclick="() => multiplier = 1">S</button>
      <button class="@(multiplier==2?"picked":"")" @onclick="() => multiplier = 2">D ×2</button>
      <button class="@(multiplier==3?"picked":"")" @onclick="() => multiplier = 3">T ×3</button>
      <button class="miss-btn" @onclick="() => Fire(0)"><Icon Name="miss" Size="16" /></button>
    </div>
  </article>
}
@code {
  private int multiplier = 1;
  private bool Scoring => Snap.Settings.Kind != GameKind.NoScoreCricket;

  private static bool IsCricketHit(DartHit d) => d.Segment is >= 15 and <= 20 or 25;

  private async Task Fire(int segment)
  {
    if (!CanInput) return;
    var hit = segment == 0 ? DartHit.Miss : new DartHit(segment, segment == 25 ? Math.Min(2, multiplier) : multiplier);
    multiplier = 1;
    await Throw(hit);
  }

  private RenderFragment PlayerHeader(int i) => __builder =>
  {
    var p = Snap.Players[i];
    <div class="cb-player @(IsActive(i) ? "active" : "") @(Snap.WinnerId == p.Id ? "winner" : "")">
      <strong><Icon Name="@(p.IsBot ? "bot" : "user")" Size="12" /> @p.Name</strong>
      <div class="cb-points">@(Scoring ? p.Score.ToString() : $"{GameRules.CricketNumbers.Count(n => p.MarksOn(n) >= 3)}/7")</div>
    </div>
  };

  private RenderFragment MarkCell(int i, int number, bool dead) => __builder =>
  {
    <div class="cb-marks @(IsActive(i) ? "active" : "") @(dead ? "dead" : "")"><CricketMark Count="Snap.Players[i].MarksOn(number)" /></div>
  };

  private RenderFragment NumberCell(int number, bool dead) => __builder =>
  {
    <button class="cb-number @(dead ? "dead" : "")" disabled="@(!CanInput)" @onclick="() => Fire(number)">@(number == 25 ? "B" : number.ToString())</button>
  };
}
