@* Home screen in the BikeTa style: hero with brand bar + greeting (animated dartboard as the hero picture),
   big choice cards with accent glow and outline, a stats card with the daily goal ring and quick-start chips. *@
<section class="home">
  <div class="home-hero">
    <div class="hh-picture">
      <div class="board-stage">
        <Dartboard Class="hero-board" Highlight="20" />
        <div class="flying-dart d1"><DartSprite /></div>
        <div class="flying-dart d2"><DartSprite /></div>
        <div class="flying-dart d3"><DartSprite /></div>
        <div class="score-pop">180!</div>
      </div>
    </div>
    <div class="hh-shade"></div>
    <div class="hh-overlay">
      <div class="hh-top">
        <img class="hh-logo" src="img/logo.png" alt="DartTA" />
        <div class="hh-brand"><b>DARTTA</b><small>SCORE · TRAIN · PROGRESS</small></div>
        <button class="hh-btn" @onclick='() => OnNavigate.InvokeAsync("Settings")' title="Settings"><Icon Name="sliders" Size="20" /></button>
      </div>
      <div class="hh-greeting">Good to see you back!</div>
      <div class="hh-tagline">Your next 180 starts here.</div>
    </div>
  </div>

  <div class="home-cards">
    @if (HasActiveMatch)
    {
      <button class="choice" style="--acc:242,193,78" @onclick="OnResume">
        <span class="ch-pic"><Icon Name="play" Size="120" Stroke="1.2" /></span>
        <span class="ch-tile"><Icon Name="play" Size="26" /></span>
        <span class="ch-text"><b>Resume match</b><small>Your game is still running – jump back in.</small></span>
        <span class="ch-go"><Icon Name="back" Size="15" /></span>
      </button>
    }
    @foreach (var c in Choices)
    {
      var choice = c;
      <button class="choice" style="--acc:@choice.Accent" @onclick="() => Open(choice.Tab)">
        @if (choice.Tab == "Play")
        {
          <span class="ch-pic board"><Dartboard Class="ch-board" Highlight="20" /></span>
        }
        else
        {
          <span class="ch-pic"><Icon Name="@choice.Icon" Size="120" Stroke="1.2" /></span>
        }
        <span class="ch-tile"><Icon Name="@choice.Icon" Size="26" /></span>
        <span class="ch-text"><b>@choice.Title</b><small>@choice.Text</small></span>
        <span class="ch-go"><Icon Name="back" Size="15" /></span>
      </button>
    }

    <button class="week-card" @onclick='() => OnNavigate.InvokeAsync("Statistics")'>
      <span class="wk-left">
        <span class="wk-kicker">YOUR STATS</span>
        <span class="wk-values">
          <span><b>@Matches</b><small>Matches</small></span>
          <span><b>@TrainingDarts</b><small>Darts</small></span>
          <span><b>@HitRate</b><small>Hit rate</small></span>
        </span>
      </span>
      <span class="wk-ring" style="--share:@GoalShare">
        <svg viewBox="0 0 84 84"><circle class="trk" cx="42" cy="42" r="37" /><circle class="arc" cx="42" cy="42" r="37" pathLength="100" /></svg>
        <span><b>@TodayDarts</b><small>/ @DailyGoal today</small></span>
      </span>
    </button>

    <div class="wk-kicker qs">QUICK START</div>
    <div class="quick-chips">
      @foreach (var kind in Featured)
      {
        var k = kind;
        <button class="quick-chip" @onclick="() => OnQuick.InvokeAsync(k)"><Icon Name="@Icon.ForGame(k)" Size="18" /> @GameRules.Name(k)</button>
      }
      <button class="quick-chip" @onclick="OnPlay"><Icon Name="plus" Size="18" /> All games</button>
    </div>
  </div>
</section>
@code {
  [Parameter] public int Matches { get; set; }
  [Parameter] public int TrainingDarts { get; set; }
  [Parameter] public int TodayDarts { get; set; }
  [Parameter] public string HitRate { get; set; } = "0%";
  [Parameter] public bool HasActiveMatch { get; set; }
  [Parameter] public EventCallback OnPlay { get; set; }
  [Parameter] public EventCallback OnResume { get; set; }
  [Parameter] public EventCallback<GameKind> OnQuick { get; set; }
  /// <summary>Opens a tab by name (Training, Challenges, Statistics, Settings).</summary>
  [Parameter] public EventCallback<string> OnNavigate { get; set; }

  private const int DailyGoal = 60;
  private string GoalShare => Math.Clamp(TodayDarts * 100 / DailyGoal, 0, 100).ToString();

  /// <summary>Choice cards: tab, icon, accent (r,g,b – BikeTa colours), title, text.</summary>
  private static readonly (string Tab, string Icon, string Accent, string Title, string Text)[] Choices =
  [
    ("Play", "dart", "242,92,84", "Play", "X01, Cricket & more – up to 8 players or the DartBot."),
    ("Training", "crosshair", "78,210,160", "Training", "Triples, doubles and bull drills with hit rate."),
    ("Challenges", "star", "166,107,242", "Goals", "Daily challenges to keep your arm sharp."),
    ("Statistics", "chart", "61,155,233", "Statistics", "Match history, winners and your hit rate."),
  ];

  private static readonly GameKind[] Featured = [GameKind.X01, GameKind.Cricket, GameKind.AroundTheClock, GameKind.Shanghai, GameKind.HalveIt];

  private Task Open(string tab) => tab == "Play" ? OnPlay.InvokeAsync() : OnNavigate.InvokeAsync(tab);
}
