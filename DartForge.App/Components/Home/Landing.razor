@using DartForge.Streaks
@using SportTA.Streaks
@inherits LocalizedComponentBase
@* Home screen in the BikeTa style: hero with brand bar + greeting (animated dartboard as the hero picture),
   big choice cards with accent glow and outline, a stats card with the daily goal ring and quick-start chips. *@
<section class="home">
  <div class="home-hero">
    <div class="hh-picture">
      <div class="board-stage">
        <Dartboard Class="hero-board" Highlight="20" />
        <div class="flying-dart d1"><DartSprite /></div>
        <div class="flying-dart d2"><DartSprite /></div>
        <div class="flying-dart d3"><DartSprite /></div>
        <div class="score-pop">180!</div>
      </div>
    </div>
    <div class="hh-shade"></div>
    <div class="hh-overlay">
      <div class="hh-top">
        <img class="hh-logo" src="img/logo.png" alt="DartTA" />
        <div class="hh-brand"><b>DARTTA</b><small>@L("Home_Slogan")</small></div>
        <button class="hh-btn" @onclick='() => OnNavigate.InvokeAsync("Settings")' title="@L("Common_Settings")"><Icon Name="sliders" Size="20" /></button>
      </div>
      <div class="hh-greeting">@L("Home_Greeting")</div>
      <div class="hh-tagline">@L("Home_Tagline")</div>
    </div>
  </div>

  <div class="home-cards">
    @ChildContent
    @if (HasActiveMatch)
    {
      <button class="choice" style="--acc:242,193,78" @onclick="OnResume">
        <span class="ch-pic"><Icon Name="play" Size="120" Stroke="1.2" /></span>
        <span class="ch-tile"><Icon Name="play" Size="26" /></span>
        <span class="ch-text"><b>@L("Home_Resume_Title")</b><small>@L("Home_Resume_Text")</small></span>
        <span class="ch-go"><Icon Name="back" Size="15" /></span>
      </button>
    }
    @foreach (var c in Choices)
    {
      var choice = c;
      <button class="choice" style="--acc:@choice.Accent" @onclick="() => Open(choice.Tab)">
        @if (choice.Tab == "Play")
        {
          <span class="ch-pic board"><Dartboard Class="ch-board" Highlight="20" /></span>
        }
        else
        {
          <span class="ch-pic"><Icon Name="@choice.Icon" Size="120" Stroke="1.2" /></span>
        }
        <span class="ch-tile"><Icon Name="@choice.Icon" Size="26" /></span>
        <span class="ch-text"><b>@L(choice.TitleKey)</b><small>@L(choice.TextKey)</small></span>
        <span class="ch-go"><Icon Name="back" Size="15" /></span>
      </button>
    }

    @* Daily-goal streak (BikeTa choice card, gold accent): current + longest run and a hint while today's goal is open. *@
    <button class="choice streak" style="--acc:242,193,78" @onclick='() => OnNavigate.InvokeAsync("Training")'>
      <span class="ch-pic"><Icon Name="flame" Size="120" Stroke="1.2" /></span>
      <span class="ch-tile"><Icon Name="flame" Size="26" /></span>
      <span class="ch-text">
        <b>@L("Home_StreakCard_Title")</b>
        <small>@L("Home_StreakCard_Stats", StreakText.Count(DartTaStreaks.DailyGoal, StreakCurrent).Resolve(Loc), StreakText.Count(DartTaStreaks.DailyGoal, StreakLongest).Resolve(Loc))</small>
        @switch (StreakHint)
        {
          case "safe":
            <small class="sc-hint safe"><Icon Name="check" Size="12" /> @L("Home_StreakCard_Safe")</small>
            break;
          case "risk":
            <small class="sc-hint risk"><Icon Name="bolt" Size="12" /> @L("Home_StreakCard_AtRisk", TodayDarts, DailyGoal)</small>
            break;
          default:
            <small class="sc-hint">@L("Home_StreakCard_Start", DailyGoal)</small>
            break;
        }
      </span>
      <span class="ch-go"><Icon Name="back" Size="15" /></span>
    </button>

    <button class="week-card" @onclick='() => OnNavigate.InvokeAsync("Statistics")'>
      <span class="wk-left">
        <span class="wk-kicker">@L("Home_YourStats")</span>
        <span class="wk-values">
          <span><b>@Matches</b><small>@L("Statistics_Matches")</small></span>
          <span><b>@TrainingDarts</b><small>@L("Home_Darts")</small></span>
          <span><b>@HitRate</b><small>@L("Statistics_HitRate")</small></span>
        </span>
      </span>
      <span class="wk-ring" style="--share:@GoalShare">
        <svg viewBox="0 0 84 84"><circle class="trk" cx="42" cy="42" r="37" /><circle class="arc" cx="42" cy="42" r="37" pathLength="100" /></svg>
        <span><b>@TodayDarts</b><small>@L("Home_TodayOfGoal", DailyGoal)</small></span>
      </span>
    </button>

    <div class="wk-kicker qs">@L("Home_QuickStart")</div>
    <div class="quick-chips">
      @foreach (var kind in Featured)
      {
        var k = kind;
        <button class="quick-chip" @onclick="() => OnQuick.InvokeAsync(k)"><Icon Name="@Icon.ForGame(k)" Size="18" /> @Loc.GameName(k)</button>
      }
      <button class="quick-chip" @onclick="OnPlay"><Icon Name="plus" Size="18" /> @L("Home_AllGames")</button>
    </div>
  </div>
</section>
@code {
  [Parameter] public int Matches { get; set; }
  [Parameter] public int TrainingDarts { get; set; }
  [Parameter] public int TodayDarts { get; set; }
  [Parameter] public string HitRate { get; set; } = "0%";
  [Parameter] public bool HasActiveMatch { get; set; }
  /// <summary>Progress of the daily-goal streak; <see langword="null"/> shows an empty (0 / 0) card.</summary>
  [Parameter] public StreakProgress? DailyStreak { get; set; }
  /// <summary>Shown above the cards (streak notices).</summary>
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public EventCallback OnPlay { get; set; }
  [Parameter] public EventCallback OnResume { get; set; }
  [Parameter] public EventCallback<GameKind> OnQuick { get; set; }
  /// <summary>Opens a tab by name (Training, Challenges, Statistics, Settings).</summary>
  [Parameter] public EventCallback<string> OnNavigate { get; set; }

  private const int DailyGoal = DartTaStreaks.DailyGoalDarts;
  private int StreakCurrent => DailyStreak?.CurrentCount ?? 0;
  private int StreakLongest => DailyStreak?.LongestCount ?? 0;
  /// <summary>"safe" (today's goal reached), "risk" (a running streak breaks unless today's goal is reached) or "start".</summary>
  private string StreakHint => DailyStreak switch
  {
    { CurrentCount: > 0, IsCurrentPeriodComplete: true } => "safe",
    { CurrentCount: > 0, IsAtRisk: true } => "risk",
    _ => "start"
  };
  private string GoalShare => Math.Clamp(TodayDarts * 100 / DailyGoal, 0, 100).ToString();

  /// <summary>Choice cards: tab, icon, accent (r,g,b – BikeTa colours), title and text resource keys.</summary>
  private static readonly (string Tab, string Icon, string Accent, string TitleKey, string TextKey)[] Choices =
  [
    ("Play", "dart", "242,92,84", "Nav_Play", "Home_Play_Text"),
    ("Training", "crosshair", "78,210,160", "Page_Training_Title", "Home_Training_Text"),
    ("Challenges", "star", "166,107,242", "Page_Goals_Title", "Home_Goals_Text"),
    ("Statistics", "chart", "61,155,233", "Page_Statistics_Title", "Home_Statistics_Text"),
  ];

  private static readonly GameKind[] Featured = [GameKind.X01, GameKind.Cricket, GameKind.AroundTheClock, GameKind.Shanghai, GameKind.HalveIt];

  private Task Open(string tab) => tab == "Play" ? OnPlay.InvokeAsync() : OnNavigate.InvokeAsync(tab);
}
