<?xml version="1.0" encoding="utf-8"?>
<!-- DartTA only needs public packages. Clearing inherited sources keeps restores independent of
     private/company feeds configured on the machine (which can fail with 401). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
