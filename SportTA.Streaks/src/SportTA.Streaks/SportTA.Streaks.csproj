<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SportTA.Streaks</RootNamespace>
    <AssemblyName>SportTA.Streaks</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>1.0.0</Version>
    <PackageId>SportTA.Streaks</PackageId>
    <Description>Reusable, UI- and storage-agnostic streak system (daily, weekly, consecutive and custom streaks) for .NET 8 apps and games.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SportTA.Streaks.Tests" />
  </ItemGroup>

</Project>
