<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ignore machine-wide feeds (e.g. private feeds that return 401); restore from nuget.org only. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
