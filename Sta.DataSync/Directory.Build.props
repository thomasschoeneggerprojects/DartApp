<Project>
  <!-- Shared settings for every Sta.DataSync project. This file stops MSBuild from importing the
       DartTA repository's Directory.Build.props, so the folder can move to its own repository unchanged. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <Version>1.0.0</Version>
    <Authors>STA</Authors>
    <Company>STA</Company>
    <Product>Sta.DataSync</Product>
    <Copyright>STA</Copyright>
    <PackageTags>sync;synchronization;offline-first;google-drive;maui</PackageTags>
  </PropertyGroup>
</Project>
